{
  "version": 6,
  "configurePresets": [
    {
      "name": "container",
      "displayName": "Host-side container commands",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/control",
      "cacheVariables": {"SWAG_CONTAINER_ONLY": "ON"}
    },
    {
      "name": "probe",
      "displayName": "GCC 15 rendering probe",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/probe",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    }
  ],
  "buildPresets": [
    {"name": "probe", "configurePreset": "probe"},
    {"name": "container", "configurePreset": "container"}
  ]
}
